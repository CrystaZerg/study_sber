{
  "name": "mcp-yandex",
  "version": "1.0.0",
  "description": "MCP-сервер для чтения публичных данных Яндекса (ya.ru): проверка доступности, метаданные главной страницы, поисковые подсказки.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-yandex": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18"
  }
}